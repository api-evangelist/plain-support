              "body": "{\n  \"data\": {\n    \"key_0\": 8088,\n    \"key_1\": 2994\n  },\n  \"errors\": [\n    {\n      \"message\": \"string\",\n      \"path\": [\n        \"string\",\n        \"string\"\n      ],\n      \"locations\": [\n        {\n          \"line\": 8646,\n          \"column\": 7689\n        },\n        {\n          \"line\": 4160,\n          \"column\": 3619\n        }\n      ],\n      \"extensions\": {\n        \"key_0\": \"string\"\n      }\n    },\n    {\n      \"message\": \"string\",\n      \"path\": [\n        \"string\",\n        \"string\"\n      ],\n      \"locations\": [\n        {\n          \"line\": 7472,\n          \"column\": 28\n        },\n        {\n          \"line\": 9634,\n          \"column\": 6583\n        }\n      ],\n      \"extensions\": {\n        \"key_0\": true,\n        \"key_1\": \"string\"\n      }\n    }\n  ],\n  \"extensions\": {\n    \"key_0\": false\n  }\n}",
